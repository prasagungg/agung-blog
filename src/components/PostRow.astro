---
interface Props {
  title: string;
  date: string;
  link: string;
}

const { title, date, link } = Astro.props;
const [day, month] = date.split(' ');
---

<a href={link} class="block group no-underline">
  <div class="pixel-box bg-white hover:bg-[var(--color-cozy-cream)] transition-colors flex items-stretch p-0 overflow-hidden group-hover:-translate-y-1">
      
      <div class="bg-[var(--color-cozy-orange)] text-white w-20 flex flex-col items-center justify-center p-2 font-pixel border-r-4 border-[var(--color-cozy-brown)] group-hover:bg-[var(--color-cozy-yellow)] group-hover:text-[var(--color-cozy-brown)] transition-colors">
          <span class="text-2xl font-bold leading-none">{day}</span>
          <span class="text-[10px] font-bold uppercase tracking-wider">{month}</span>
      </div>
      
      <div class="p-4 flex items-center grow">
          <h3 class="text-lg font-pixel font-bold text-[var(--color-cozy-brown)] group-hover:text-[var(--color-cozy-orange)] transition-colors line-clamp-2">
              {title}
          </h3>
      </div>
  </div>
</a>