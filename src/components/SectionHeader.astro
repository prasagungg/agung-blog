---
interface Props {
  title: string;
  variant?: 'cyan' | 'white'; 
}

const { title } = Astro.props;
---

<div class="flex items-center gap-4 mb-8">
  <h2 class="text-2xl font-bold font-pixel uppercase text-[var(--color-cozy-orange)] tracking-wide flex items-center gap-2">
    <span class="text-xl">►</span>
    {title}
  </h2>
  <div class="h-1 grow border-t-4 border-dashed border-[var(--color-cozy-brown)]/30 mt-1"></div>
</div>