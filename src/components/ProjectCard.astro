---
interface Props {
  title: string;
  desc: string;
  tech: string[];
  link: string;
}

const { title, desc, tech, link } = Astro.props;
---

<a href={link} class="group block relative no-underline h-full">
  <div class="pixel-box bg-white hover:bg-[var(--color-cozy-cream)] transition-colors h-full flex flex-col">
      <div class="flex justify-between items-start mb-2 relative z-10">
          <h3 class="text-xl font-bold font-pixel text-[var(--color-cozy-brown)] group-hover:text-[var(--color-cozy-orange)] transition-colors uppercase tracking-wide">
              {title}
          </h3>
          <span class="text-[var(--color-cozy-orange)] opacity-0 group-hover:opacity-100 transition-opacity font-pixel">++</span>
      </div>

      <p class="text-[var(--color-cozy-brown)]/80 mb-4 line-clamp-2 leading-relaxed text-sm grow">
        {desc}
      </p>
      
      <div class="flex gap-2 flex-wrap mt-auto pt-4 border-t-2 border-dashed border-[var(--color-cozy-brown)]/30">
          {tech.map((t) => (
              <span class="text-[10px] uppercase font-bold font-pixel px-2 py-1 bg-[var(--color-cozy-bg)] text-[var(--color-cozy-sage)] border-2 border-dashed border-[var(--color-cozy-brown)]/50">
                  {t}
              </span>
          ))}
      </div>
  </div>
</a>